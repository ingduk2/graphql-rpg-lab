type Query {
    ping: String

    # Player
    players: [Player!]!
    player(id: ID!): Player

    # Monster
    monsters: [Monster!]!
    monster(id: ID!): Monster

    # Quest
    quests: [Quest!]!
}

type Mutation {
    # Player
    createPlayer(input: CreatePlayerInput!): Player!

    # Item
    equipItem(playerId: ID!, itemId: ID!): Inventory!
    unequipItem(playerId: ID!, itemId: ID!): Inventory!

    # Quest
    acceptQuest(playerId: ID!, questId: ID!): PlayerQuest!
    completeQuest(playerId: ID!, questId: ID!): PlayerQuest!

    # Battle
    attack(playerId: ID!, monsterId: ID!): BattleResult!
    flee(playerId: ID!, monsterId: ID!): BattleResult!
}

type Subscription {
    battleEvents(battleId: ID!): BattleEvent!
}

input CreatePlayerInput {
    name: String!
}

type BattleResult {
    damage: Int!
    remainHp: Int!
    isCritical: Boolean!
    message: String!
    monsterDefeated: Boolean!
}

type BattleEvent {
    battleId: ID!
    turn: Int!
    damage: Int!
    remainHp: Int!
    isCritical: Boolean!
    message: String!
    finished: Boolean!
}

type Player {
    id: ID!
    name: String!
    level: Int!
    hp: Int!
    maxHp: Int!
    stats: Stats!
    inventory: Inventory
    quests: [Quest!]!
}

type Stats {
    attack: Int!
    defense: Int!
    speed: Int!
}

type Monster {
    id: ID!
    name: String!
    hp: Int!
    maxHp: Int!
    attackPower: Int!
}

type Item {
    id: ID!
    name: String!
    type: ItemType!
    attackBonus: Int!
    defenseBonus: Int!
}

enum ItemType {
    WEAPON
    ARMOR
    ACCESSORY
}

type Inventory {
    id: ID!
    items: [Item!]!
}

type Quest {
    id: ID!
    title: String!
    description: String
}

type PlayerQuest {
    id: ID!
    questId: ID!
    status: QuestStatus!
    title: String!
    description: String
}

enum QuestStatus {
    AVAILABLE
    IN_PROGRESS
    COMPLETED
}