type Query {
    ping: String

    # Player
    players: [Player!]!
    player(id: ID!): Player

    # Monster
    monsters: [Monster!]!
    monster(id: ID!): Monster

    # Quest
    quests: [Quest!]!
}

type Mutation {
    # Player
    createPlayer(input: CreatePlayerInput!): Player!

    # Item
    equipItem(itemId: ID!): Inventory!
    unequipItem(itemId: ID!): Inventory!

    # Quest
    acceptQuest(questId: ID!): PlayerQuest!
    completeQuest(questId: ID!): PlayerQuest!

    # Battle
    attack(monsterId: ID!, currentMonsterHp: Int!): BattleResult!
    flee(monsterId: ID!): BattleResult!
}

type Subscription {
    battleEvents(monsterId: ID!): BattleEvent!
}

input CreatePlayerInput {
    name: String!
}

type DroppedItem {
    id: ID!
    name: String!
    type: String!
    attackBonus: Int!
    defenseBonus: Int!
}

type BattleResult {
    playerDamage: Int!
    monsterDamage: Int!
    monsterRemainHp: Int!
    playerRemainHp: Int!
    isCritical: Boolean!
    monsterDefeated: Boolean!
    playerDefeated: Boolean!
    expGained: Int!
    levelUps: Int!
    droppedItem: DroppedItem
    message: String!
}

type BattleEvent {
    battleId: ID!
    turn: Int!
    playerDamage: Int!
    monsterDamage: Int!
    monsterRemainHp: Int!
    playerRemainHp: Int!
    isCritical: Boolean!
    monsterDefeated: Boolean!
    playerDefeated: Boolean!
    message: String!
    finished: Boolean!
}

type Player {
    id: ID!
    name: String!
    level: Int!
    hp: Int!
    maxHp: Int!
    exp: Int!
    stats: Stats!
    inventory: Inventory
    quests: [Quest!]!
}

type Stats {
    attack: Int!
    defense: Int!
    speed: Int!
}

type Monster {
    id: ID!
    name: String!
    hp: Int!
    maxHp: Int!
    attackPower: Int!
}

type Item {
    id: ID!
    name: String!
    type: ItemType!
    attackBonus: Int!
    defenseBonus: Int!
}

enum ItemType {
    WEAPON
    ARMOR
    ACCESSORY
}

type Inventory {
    id: ID!
    items: [Item!]!
}

type Quest {
    id: ID!
    title: String!
    description: String
}

type PlayerQuest {
    id: ID!
    questId: ID!
    status: QuestStatus!
    title: String!
    description: String
}

enum QuestStatus {
    AVAILABLE
    IN_PROGRESS
    COMPLETED
}